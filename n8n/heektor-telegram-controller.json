{
  "name": "HEEKTOR - Telegram Controller",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {
          "userIds": "TWOJ_USER_ID",
          "chatIds": "TWOJ_CHAT_ID"
        }
      },
      "id": "a1111111-1111-4111-8111-111111111111",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "webhookId": "heektor-telegram-controller"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ String($json.message?.from?.id) }}",
              "rightValue": "TWOJ_USER_ID",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "id": "c2",
              "leftValue": "={{ String($json.message?.chat?.id) }}",
              "rightValue": "TWOJ_CHAT_ID",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2222222-2222-4222-8222-222222222222",
      "name": "AUTHORIZED OWNER?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "chatId": "={{ $json.message.chat.id }}",
        "text": "=✅ HEEKTOR Support działa.\nOdebrałem: {{ $json.message.text }}",
        "additionalFields": { "appendAttribution": false }
      },
      "id": "c3333333-3333-4333-8333-333333333333",
      "name": "Telegram Reply",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [520, -80]
    }
  ],
  "connections": {
    "Telegram Trigger": { "main": [[{ "node": "AUTHORIZED OWNER?", "type": "main", "index": 0 }]] },
    "AUTHORIZED OWNER?": { "main": [[{ "node": "Telegram Reply", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1" }
}
