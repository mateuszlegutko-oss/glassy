      "id": "b2000000-0000-4000-8000-000000000005",
      "name": "Gmail: Sent",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        960,
        -60
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "",
          "name": "Gmail HEEKTOR"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const unread = $('Gmail: Inbox UNREAD').all().map(i => i.json);\nconst sent = $('Gmail: Sent').all().map(i => i.json);\nconst lastSentByThread = {};\nfor (const s of sent) {\n  const t = s.threadId; const ts = Number(s.internalDate || 0);\n  if (!lastSentByThread[t] || ts > lastSentByThread[t]) lastSentByThread[t] = ts;\n}\nconst seen = new Set(); const pending = [];\nfor (const m of unread) {\n  if (seen.has(m.threadId)) continue; seen.add(m.threadId);\n  const ts = Number(m.internalDate || 0);\n  // pomijamy wątki, w których support odpisał PO ostatnim mailu klienta\n  if (lastSentByThread[m.threadId] && lastSentByThread[m.threadId] > ts) continue;\n  pending.push(m);\n}\nconst chatId = $('Telegram Trigger').first().json.message.chat.id;\nlet text = pending.length ? `📬 Do obsłużenia: ${pending.length}\\n\\n` : '✅ Brak nieobsłużonych maili.';\npending.slice(0, 30).forEach((m, i) => {\n  text += `${i + 1}. ${m.From || m.from?.text || '?'}\\n   ${m.Subject || m.subject || '(brak tematu)'}\\n`;\n});\nreturn [{ json: { chatId, text } }];"
      },
